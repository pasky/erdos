# Adapted from Python .gitattributes template (https://github.com/gitattributes/gitattributes/blob/master/Python.gitattributes)

# Source files
# ============
*.pxd    text diff=python
*.py     text diff=python
*.py3    text diff=python
*.pyw    text diff=python
*.pyx    text diff=python
*.pyz    text diff=python
*.pyi    text diff=python

# Binary files
# ============
*.db     binary
*.p      binary
*.pkl    binary
*.pickle binary
*.pyc    binary export-ignore
*.pyo    binary export-ignore
*.pyd    binary

# Jupyter notebook
*.ipynb  text eol=lf

# Windows batch files
*.bat    text eol=crlf

# Wiki index merge driver
**/_index.md merge=wiki

# Git LFS
*.[pP][dD][fF] filter=lfs diff=lfs merge=lfs -text

# arXiv records beside library PDFs: pulled bytes, never normalized
**/.arxiv/** -text
# Sidecar members that are rendered pages or images: pulled bytes, in LFS
**/.arxiv/**/*.[pP][nN][gG] filter=lfs diff=lfs merge=lfs -text
**/.arxiv/**/*.[sS][vV][gG] filter=lfs diff=lfs merge=lfs -text
**/.arxiv/**/*.[eE][pP][sS] filter=lfs diff=lfs merge=lfs -text
**/.arxiv/**/*.[jJ][pP][gG] filter=lfs diff=lfs merge=lfs -text
