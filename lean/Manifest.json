   "statement":
   {"sha256Unfolded": "b4bb12970a1602f2196390c99fb81a38d42b5084f8e6e0bf6af4512954cfa36e",
    "sha256": "539172fcb87926e706d08d9cd05eb81b0f31062f0061d9c4d96a621152edb84a",
    "pretty":
    "∃ (K : ℝ),\n  0 < K ∧\n    ∀ (A : Finset ℂ),\n      ↑A ⊆ Erdos.L20.rootsOfUnity →\n        ∀ (c : ℂ → ℂ), ∃ (χ : AddChar ℂ Circle), ∑ z ∈ A, ‖c z‖ ≤ K * ‖∑ z ∈ A, c z * ↑(χ z)‖"},
   "module": "Erdos.L20",
   "id": "L20",
   "depends": [],
   "decls":
   [{"role": "statement", "name": "Erdos.L20.statement"},
    {"role": "claim", "name": "Erdos.L20.claim"}],
   "compiler": [],
   "axioms": ["propext", "Classical.choice", "Quot.sound"]},
  {"surface":
   {"sha256": "d7c7999191f4c919ec1fec10737edafaff0eef8b9cbecaa5b0c41624ec54421c",
    "external": 28,
    "constants": 2},
   "statement":
   {"sha256Unfolded": "a1a54b919c01ebd7950cb77add095c60bb1c206bda61387e031939dd11023d8e",
    "sha256": "ae7f4ab9f783fe1265f8abd0908060bef42c3377649328c1537a2b2af992d9c8",
    "pretty":
    "∃ (k : ℕ),\n  0 < k ∧\n    ∀ (A : Finset ℂ), ↑A ⊆ Erdos.L21.rootsOfUnity → ∃ B ⊆ A, AddDissociated ↑B ∧ A.card ≤ k * B.card"},
