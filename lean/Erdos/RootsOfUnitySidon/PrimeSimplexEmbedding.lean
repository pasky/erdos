import Mathlib.Data.Nat.Totient
import Mathlib.Data.Nat.GCD.BigOperators
import Mathlib.FieldTheory.LinearDisjoint
import Mathlib.NumberTheory.Cyclotomic.Basic
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
import Mathlib.RingTheory.RootsOfUnity.Complex
import Mathlib.RingTheory.PowerBasis
import Mathlib.Tactic

/-!
# Prime simplex coordinates in cyclotomic fields

The first `p - 1` powers of a primitive `p`-th root give a rational basis of
its cyclotomic field. The intended multi-prime result says that products of
these powers stay rationally linearly independent for distinct prime orders.
The multi-prime linear independence and integer-lattice injectivity claims
-/

namespace Erdos.Research.Problem774.PrimeSimplex

/-- The standard primitive complex root of order `n`. -/
noncomputable def zeta (n : ℕ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (n : ℂ))

theorem zeta_primitive (n : ℕ) (hn : 0 < n) : IsPrimitiveRoot (zeta n) n :=
  Complex.isPrimitiveRoot_exp n hn.ne'

/-- The `p - 1` simplex coordinates have no rational linear relation. -/
theorem prime_powers_linearIndependent {p : ℕ} (hp : p.Prime)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ p) :
    LinearIndependent ℚ (fun i : Fin (p - 1) => ζ ^ (i : ℕ)) := by
  have hdegree : (minpoly ℚ ζ).natDegree = p - 1 := by
    rw [← Polynomial.cyclotomic_eq_minpoly_rat hζ hp.pos,
      Polynomial.natDegree_cyclotomic, Nat.totient_prime hp]
  have hli := linearIndependent_pow (K := ℚ) ζ
  rw [hdegree] at hli
  exact hli

theorem zeta_prime_powers_linearIndependent {p : ℕ} (hp : p.Prime) :
    LinearIndependent ℚ (fun i : Fin (p - 1) => zeta p ^ (i : ℕ)) :=
  prime_powers_linearIndependent hp (zeta_primitive p hp.pos)

/-- All `p` root columns sum to zero. -/
theorem prime_columns_sum_zero {p : ℕ} (hp : p.Prime) :
    (∑ j ∈ Finset.range p, zeta p ^ j) = 0 :=
  (zeta_primitive p hp.pos).geom_sum_eq_zero hp.one_lt

/-- The omitted last column is the negative sum of the simplex basis columns. -/
theorem prime_last_column {p : ℕ} (hp : p.Prime) :
    zeta p ^ (p - 1) = -∑ j ∈ Finset.range (p - 1), zeta p ^ j := by
  simpa [Nat.pred_eq_sub_one] using
    (zeta_primitive p hp.pos).pow_sub_one_eq hp.one_lt

/-- The rational degree of the field generated by a primitive complex root. -/
theorem primitive_field_finrank {n : ℕ} (hn : 0 < n)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n) :
    Module.finrank ℚ (IntermediateField.adjoin ℚ ({ζ} : Set ℂ)) = n.totient := by
  have hζalg : IsAlgebraic ℚ ζ := (((hζ.isIntegral hn).tower_top).isAlgebraic)
  have hdegree : Module.finrank ℚ (Algebra.adjoin ℚ ({ζ} : Set ℂ)) = n.totient := by
    letI : NeZero n := ⟨hn.ne'⟩
    letI : IsCyclotomicExtension {n} ℚ (Algebra.adjoin ℚ ({ζ} : Set ℂ)) :=
      hζ.adjoin_isCyclotomicExtension ℚ
    exact IsCyclotomicExtension.finrank _ (Polynomial.cyclotomic.irreducible_rat hn)
  calc
    Module.finrank ℚ (IntermediateField.adjoin ℚ ({ζ} : Set ℂ)) =
        Module.finrank ℚ (IntermediateField.adjoin ℚ ({ζ} : Set ℂ)).toSubalgebra :=
      (IntermediateField.finrank_eq_finrank_subalgebra _).symm
    _ = Module.finrank ℚ (Algebra.adjoin ℚ ({ζ} : Set ℂ)) := by
      rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic]
      simpa using hζalg
    _ = n.totient := hdegree

/-- The field generated by a primitive complex root carries the corresponding
singleton cyclotomic-extension structure. -/
private theorem cyclotomic_field_instance {n : ℕ} (hn : 0 < n)
    {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n) :
    IsCyclotomicExtension {n} ℚ (IntermediateField.adjoin ℚ ({ζ} : Set ℂ)) := by
  letI : NeZero n := ⟨hn.ne'⟩
  have hζalg : IsAlgebraic ℚ ζ := (((hζ.isIntegral hn).tower_top).isAlgebraic)
  change IsCyclotomicExtension {n} ℚ
    (IntermediateField.adjoin ℚ ({ζ} : Set ℂ)).toSubalgebra
  rw [IntermediateField.adjoin_toSubalgebra_of_isAlgebraic]
  · exact hζ.adjoin_isCyclotomicExtension ℚ
  · intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact hζalg

/-- The cyclotomic subfield generated by the standard complex root. -/
noncomputable def primeField (n : ℕ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ ({zeta n} : Set ℂ)

/-- Cyclotomic fields of coprime conductors are linearly disjoint over `ℚ`.
This degree statement is the algebraic reason prime simplex tensors have no
extra additive relations. -/
theorem coprime_fields_linearDisjoint (m n : ℕ)
    (hm : 0 < m) (hn : 0 < n) (hc : m.Coprime n) :
    (primeField m).LinearDisjoint (primeField n) := by
  letI : NeZero m := ⟨hm.ne'⟩
  letI : NeZero n := ⟨hn.ne'⟩
  letI : NeZero (m * n) := ⟨(mul_pos hm hn).ne'⟩
  haveI : IsCyclotomicExtension {m} ℚ (primeField m) :=
    cyclotomic_field_instance hm (zeta_primitive m hm)
  haveI : IsCyclotomicExtension {n} ℚ (primeField n) :=
    cyclotomic_field_instance hn (zeta_primitive n hn)
  haveI : IsCyclotomicExtension {m * n} ℚ (primeField (m * n)) :=
    cyclotomic_field_instance (mul_pos hm hn) (zeta_primitive (m * n) (mul_pos hm hn))
  have hsup : primeField m ⊔ primeField n = primeField (m * n) := by
    have hsupInst : IsCyclotomicExtension {m * n} ℚ
        ↥(primeField m ⊔ primeField n) := by
      rw [← hc.lcm_eq_mul]
      exact IntermediateField.isCyclotomicExtension_lcm_sup ℚ ℂ m n
        (primeField m) (primeField n)
          (h₁ := cyclotomic_field_instance hm (zeta_primitive m hm))
          (h₂ := cyclotomic_field_instance hn (zeta_primitive n hn))
    exact IntermediateField.isCyclotomicExtension_eq
      (S := {m * n}) (K := ℚ) (L := ℂ)
      (primeField m ⊔ primeField n) (primeField (m * n))
      (h₁ := hsupInst)
      (h₂ := cyclotomic_field_instance (mul_pos hm hn)
        (zeta_primitive (m * n) (mul_pos hm hn)))
  letI : FiniteDimensional ℚ (primeField m) :=
    IntermediateField.adjoin.finiteDimensional
      (((zeta_primitive m hm).isIntegral hm).tower_top)
  letI : FiniteDimensional ℚ (primeField n) :=
    IntermediateField.adjoin.finiteDimensional
      (((zeta_primitive n hn).isIntegral hn).tower_top)
  apply IntermediateField.LinearDisjoint.of_finrank_sup
  rw [hsup, show Module.finrank ℚ (primeField (m * n)) = (m * n).totient from
      primitive_field_finrank (mul_pos hm hn) (zeta_primitive (m * n) (mul_pos hm hn)),
    Nat.totient_mul hc,
    show Module.finrank ℚ (primeField m) = m.totient from
      primitive_field_finrank hm (zeta_primitive m hm),
    show Module.finrank ℚ (primeField n) = n.totient from
      primitive_field_finrank hn (zeta_primitive n hn)]

/-- The tensor basis from two distinct prime simplices is rationally linearly
independent after multiplication into `ℂ`. -/
theorem two_prime_simplex_linearIndependent {p q : ℕ}
    (hp : p.Prime) (hq : q.Prime) (hpq : p ≠ q) :
    LinearIndependent ℚ (fun ij : Fin (p - 1) × Fin (q - 1) =>
      zeta p ^ (ij.1 : ℕ) * zeta q ^ (ij.2 : ℕ)) := by
  let a : Fin (p - 1) → primeField p := fun i =>
    ⟨zeta p ^ (i : ℕ),
      pow_mem (IntermediateField.mem_adjoin_simple_self ℚ (zeta p)) _⟩
  let b : Fin (q - 1) → primeField q := fun j =>
    ⟨zeta q ^ (j : ℕ),
      pow_mem (IntermediateField.mem_adjoin_simple_self ℚ (zeta q)) _⟩
  have ha : LinearIndependent ℚ a := by
    apply LinearIndependent.of_comp (primeField p).toSubalgebra.toSubmodule.subtype
    exact zeta_prime_powers_linearIndependent hp
  have hb : LinearIndependent ℚ b := by
    apply LinearIndependent.of_comp (primeField q).toSubalgebra.toSubmodule.subtype
    exact zeta_prime_powers_linearIndependent hq
  have hco : p.Coprime q := (Nat.coprime_primes hp hq).2 hpq
  simpa [a, b] using
    (coprime_fields_linearDisjoint p q hp.pos hq.pos hco).linearIndependent_mul ha hb

/-- The free coordinate set obtained by deleting one root from each prime
simplex. Its size is the product of the `p - 1` dimensions. -/
def SimplexTensor : List ℕ → Type
  | [] => PUnit
  | p :: ps => Fin (p - 1) × SimplexTensor ps

/-- Send a free simplex coordinate to the product of its complex root powers. -/
noncomputable def simplexValue : (ps : List ℕ) → SimplexTensor ps → ℂ
  | [], _ => 1
  | p :: ps, ij => zeta p ^ (ij.1 : ℕ) * simplexValue ps ij.2

private theorem prime_list_prod_pos (ps : List ℕ)
    (hprime : ∀ p ∈ ps, p.Prime) : 0 < ps.prod := by
  induction ps with
  | nil => simp
  | cons p ps ih =>
      rw [List.prod_cons]
      apply mul_pos (hprime p (by simp)).pos
      apply ih
      intro q hq
      exact hprime q (by simp [hq])

/-- Every simplex value is a root of the product order. -/
theorem simplexValue_pow_eq_one (ps : List ℕ) :
    (∀ p ∈ ps, p.Prime) → ∀ x : SimplexTensor ps,
      simplexValue ps x ^ ps.prod = 1 := by
  induction ps with
  | nil =>
      intro _ x
      cases x
      simp [simplexValue]
  | cons p ps ih =>
      intro hprime x
      rcases x with ⟨i, y⟩
      have hp : p.Prime := hprime p (by simp)
      have hprime' : ∀ q ∈ ps, q.Prime := by
        intro q hq
        exact hprime q (by simp [hq])
      have hfirst : (zeta p ^ (i : ℕ)) ^ p = 1 := by
        rw [← pow_mul, mul_comm (i : ℕ) p, pow_mul,
          (zeta_primitive p hp.pos).pow_eq_one, one_pow]
      have htail := ih hprime' y
      change (zeta p ^ (i : ℕ) * simplexValue ps y) ^ (p * ps.prod) = 1
      rw [mul_pow]
      have hx : (zeta p ^ (i : ℕ)) ^ (p * ps.prod) = 1 := by
        rw [pow_mul, hfirst, one_pow]
      have hy : simplexValue ps y ^ (p * ps.prod) = 1 := by
        rw [mul_comm p ps.prod, pow_mul, htail, one_pow]
      rw [hx, hy, one_mul]

/-- The simplex frequencies lie in the cyclotomic subfield of the product
order, ready for the linear-disjointness induction. -/
theorem simplexValue_mem_primeField (ps : List ℕ)
    (hprime : ∀ p ∈ ps, p.Prime) (x : SimplexTensor ps) :
    simplexValue ps x ∈ primeField ps.prod := by
  have hpos := prime_list_prod_pos ps hprime
  letI : NeZero ps.prod := ⟨hpos.ne'⟩
  obtain ⟨i, _, hi⟩ :=
    (zeta_primitive ps.prod hpos).eq_pow_of_pow_eq_one
      (simplexValue_pow_eq_one ps hprime x)
  rw [← hi]
  exact pow_mem (IntermediateField.mem_adjoin_simple_self ℚ (zeta ps.prod)) i

/-- Distinct prime simplex coordinates give a rationally linearly independent
family of complex frequencies. This rules out extra rational relations among
the selected product-power coordinates. -/
theorem simplex_linearIndependent (ps : List ℕ)
    (hprime : ∀ p ∈ ps, p.Prime) (hnodup : ps.Nodup) :
    LinearIndependent ℚ (simplexValue ps) := by
  induction ps with
  | nil =>
      change LinearIndependent ℚ (fun _ : PUnit => (1 : ℂ))
      exact LinearIndependent.of_subsingleton PUnit.unit (by norm_num)
  | cons p ps ih =>
      have hp : p.Prime := hprime p (by simp)
      have hprime' : ∀ q ∈ ps, q.Prime := by
        intro q hq
        exact hprime q (by simp [hq])
      have hnodup' : ps.Nodup := (List.nodup_cons.mp hnodup).2
      have hpnotmem : p ∉ ps := (List.nodup_cons.mp hnodup).1
      have hc : p.Coprime ps.prod :=
        Nat.coprime_list_prod_right_iff.mpr (by
          intro q hq
          apply (Nat.coprime_primes hp (hprime' q hq)).2
          intro hpq
          apply hpnotmem
          simpa [hpq] using hq)
      let a : Fin (p - 1) → primeField p := fun i =>
        ⟨zeta p ^ (i : ℕ),
          pow_mem (IntermediateField.mem_adjoin_simple_self ℚ (zeta p)) _⟩
      let b : SimplexTensor ps → primeField ps.prod := fun x =>
        ⟨simplexValue ps x, simplexValue_mem_primeField ps hprime' x⟩
      have ha : LinearIndependent ℚ a := by
        apply LinearIndependent.of_comp (primeField p).toSubalgebra.toSubmodule.subtype
        exact zeta_prime_powers_linearIndependent hp
      have hb : LinearIndependent ℚ b := by
        apply LinearIndependent.of_comp (primeField ps.prod).toSubalgebra.toSubmodule.subtype
        exact ih hprime' hnodup'
      have hli := (coprime_fields_linearDisjoint p ps.prod hp.pos
        (prime_list_prod_pos ps hprime') hc).linearIndependent_mul ha hb
      simpa [SimplexTensor, simplexValue, a, b] using hli

/-- Evaluation of the free integer lattice on simplex tensor basis vectors is
injective. It can therefore be used to transfer signed relations faithfully to
complex frequencies. -/
theorem simplex_integer_embedding_injective (ps : List ℕ)
    (hprime : ∀ p ∈ ps, p.Prime) (hnodup : ps.Nodup) :
    Function.Injective (Finsupp.linearCombination ℤ (simplexValue ps)) := by
  exact (simplex_linearIndependent ps hprime hnodup).restrict_scalars' ℤ

/-- The products of two lists of distinct primes are coprime when no prime
occurs in both lists. -/
theorem coprime_prime_list_products (small tail : List ℕ)
    (hsmall : ∀ p ∈ small, p.Prime)
    (htail : ∀ q ∈ tail, q.Prime)
    (hsep : ∀ p ∈ small, ∀ q ∈ tail, p ≠ q) :
    small.prod.Coprime tail.prod := by
  apply Nat.coprime_list_prod_left_iff.mpr
  intro p hp
  apply Nat.coprime_list_prod_right_iff.mpr
  intro q hq
  exact (Nat.coprime_primes (hsmall p hp) (htail q hq)).2 (hsep p hp q hq)

/-- The free tensor basis from the small prime factors remains linearly
independent when coefficients are allowed in the cyclotomic field generated
by all disjoint tail factors. -/
theorem simplex_linearIndependent_over_tail (small tail : List ℕ)
    (hsmall : ∀ p ∈ small, p.Prime)
    (htail : ∀ q ∈ tail, q.Prime)
    (hsmall_nodup : small.Nodup)
    (hsep : ∀ p ∈ small, ∀ q ∈ tail, p ≠ q) :
    LinearIndependent (primeField tail.prod) (simplexValue small) := by
  let a : SimplexTensor small → primeField small.prod := fun x =>
    ⟨simplexValue small x, simplexValue_mem_primeField small hsmall x⟩
  have ha : LinearIndependent ℚ a := by
    apply LinearIndependent.of_comp (primeField small.prod).toSubalgebra.toSubmodule.subtype
    exact simplex_linearIndependent small hsmall hsmall_nodup
  have hc := coprime_prime_list_products small tail hsmall htail hsep
  simpa [a, Function.comp_def] using
    (coprime_fields_linearDisjoint small.prod tail.prod
      (prime_list_prod_pos small hsmall) (prime_list_prod_pos tail htail) hc).linearIndependent_left ha

end Erdos.Research.Problem774.PrimeSimplex
