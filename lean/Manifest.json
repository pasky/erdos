    "external": 32,
    "constants": 2},
   "statement":
   {"sha256Unfolded": "4ef4234aafc96c12e494bb551b202a97aad983ab581499d1c65fa3e8bda8d691",
    "sha256": "4ef4234aafc96c12e494bb551b202a97aad983ab581499d1c65fa3e8bda8d691",
    "pretty":
    "∀ (A : Finset ℝ),\n  A.Nonempty →\n    ∃ B ⊆ A,\n      AddDissociated ↑B ∧ Real.logb 2 ↑A.card - Real.logb 2 (Real.logb 2 ↑A.card + 1) ≤ ↑B.card"},
